---
import '../styles/global.css';
import { Font } from 'astro:assets';
import CabeceraSEO from '../components/CabeceraSEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AccionesFlotantes from '../components/AccionesFlotantes.astro';

/**
 * @typedef {Object} Props
 * @property {string} titulo Contenido de `<title>`.
 * @property {string} descripcion Meta descripción de la página.
 * @property {boolean} [noindex] Excluye la página de los buscadores.
 */

/** @type {Props} */
const { titulo, descripcion, noindex = false } = Astro.props;

// El relleno inferior del `body` en móvil es el alto de la barra de `AccionesFlotantes`:
// botones de 56 px más su borde superior de 1 px.
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <Font
      cssVariable="--font-barlow-condensed"
      preload={[{ weight: 800, style: 'normal', subset: 'latin' }]}
    />
    <Font
      cssVariable="--font-chivo"
      preload={[{ weight: 400, style: 'normal', subset: 'latin' }]}
    />
    <CabeceraSEO titulo={titulo} descripcion={descripcion} noindex={noindex} />
    <slot name="head" />
  </head>
  <body class="pb-[calc(3.5rem+1px+env(safe-area-inset-bottom))] md:pb-0">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <AccionesFlotantes />
  </body>
</html>
