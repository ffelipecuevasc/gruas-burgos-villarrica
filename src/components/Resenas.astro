---
import Contenedor from './Contenedor.astro';
import TituloSeccion from './TituloSeccion.astro';
import TarjetaResena from './TarjetaResena.astro';
import Boton from './Boton.astro';
import CarruselOpiniones from './CarruselOpiniones.jsx';
import LogoGoogle from '../assets/marcas/google.svg';
import { resenas } from '../data/resenas.js';
import { enlaceOpinionesGoogle } from '../data/negocio.js';

/**
 * Opiniones de Google, con el ancla `#opiniones` (RDA-009). Van todas en el HTML, sin acordeón (RDA-007),
 * dentro de un carrusel: una por vista bajo `md`, dos desde `md` y tres desde `xl` (RDA-015 y RDA-016).
 * Si no hay reseñas, no se renderiza.
 *
 * @typedef {Object} Props
 * @property {string} [class] Clases adicionales de Tailwind.
 */

/** @type {Props} */
const { class: clase = '' } = Astro.props;

if (!resenas || resenas.length === 0) {
  return null;
}
---

<section
  id="opiniones"
  aria-labelledby="titulo-opiniones"
  class:list={[
    'border-b border-surface-container-highest bg-surface-container-lowest py-space-xl text-on-surface',
    clase,
  ]}
>
  <Contenedor class="space-y-space-xl">
    <TituloSeccion id="titulo-opiniones" bajada="Opiniones publicadas en Google.">
      Lo que dicen nuestros clientes
      {/* Logotipo de Google: marca de un tercero, sin modificar (DESIGN.md §6.2). Solo se escala.
          Desde `md` va en el extremo derecho de la fila del título; bajo `md`, debajo del título. */}
      <Fragment slot="junto">
        <LogoGoogle role="img" aria-label="Google" class="h-6 w-auto shrink-0 md:h-8" />
      </Fragment>
    </TituloSeccion>

    {/* Única isla de React del sitio (RDA-015): se hidrata cuando la sección se acerca a la vista.
        Las diapositivas se renderizan aquí, en el servidor, y la isla solo agrega el movimiento.
        El `div` recibe la separación del contenedor: `astro-island` no genera caja. */}
    <div>
      <CarruselOpiniones client:visible>
        <div class="embla__container flex gap-space-md">
          {resenas.map((resena, indice) => (
            <div
              class="embla__slide min-w-0 shrink-0 grow-0 basis-full md:basis-[calc((100%-var(--spacing-space-md))/2)] xl:basis-[calc((100%-2*var(--spacing-space-md))/3)] noscript:snap-start"
              role="group"
              aria-roledescription="opinión"
              aria-label={`Opinión ${indice + 1} de ${resenas.length}`}
            >
              <TarjetaResena resena={resena} class="h-full" />
            </div>
          ))}
        </div>
      </CarruselOpiniones>
    </div>

    <Boton href={enlaceOpinionesGoogle()} variante="contorno" externo>
      Ver más opiniones en Google
    </Boton>
  </Contenedor>
</section>
