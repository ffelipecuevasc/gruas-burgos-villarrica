---
import { negocio, localidadesTexto } from '../data/negocio.js';

/**
 * Mapa esquemático de la cobertura: SVG propio, sin escala, pensado para leerse a 360 px.
 * Los nombres y las referencias salen de `negocio.cobertura.localidades`.
 *
 * @typedef {Object} Props
 * @property {string} [class] Clases adicionales de Tailwind.
 */

/** @type {Props} */
const { class: clase = '' } = Astro.props;

// Posición de cada localidad y de su rótulo, en unidades del viewBox (320 × 410).
// Una localidad de `negocio.js` sin posición aquí no se dibuja.
const posiciones = new Map(
  Object.entries({
    Villarrica: { x: 64, y: 200, rotuloX: 82, rotuloY: 226, ancla: 'start' },
    Pucón: { x: 268, y: 200, rotuloX: 310, rotuloY: 160, ancla: 'end' },
    'Licán Ray': { x: 52, y: 318, rotuloX: 70, rotuloY: 314, ancla: 'start' },
    Freire: { x: 40, y: 56, rotuloX: 58, rotuloY: 52, ancla: 'start' },
  }),
);

const puntos = negocio.cobertura.localidades.flatMap((localidad) => {
  const posicion = posiciones.get(localidad.nombre);
  if (!posicion) return [];
  return [
    {
      ...localidad,
      ...posicion,
      esBase: localidad.nombre === negocio.direccion.comuna,
      // Una referencia con coma se reparte en dos líneas para que quepa en el ancho del mapa.
      lineas: localidad.referencia.split(', '),
    },
  ];
});
---

<div class:list={['border border-surface-container-highest bg-surface-container-lowest', clase]}>
  <svg
    viewBox="0 0 320 410"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-label={`Mapa esquemático de la cobertura: ${localidadesTexto()}`}
    class="mx-auto block h-auto w-full max-w-md"
  >
    <ellipse cx="158" cy="152" rx="70" ry="30" class="fill-surface-container-high"></ellipse>
    <text x="158" y="157" text-anchor="middle" class="fill-secondary font-body text-body-md">
      Lago Villarrica
    </text>

    <ellipse cx="150" cy="372" rx="96" ry="24" class="fill-surface-container-high"></ellipse>
    <text x="150" y="377" text-anchor="middle" class="fill-secondary font-body text-body-md">
      Lago Calafquén
    </text>

    {/* Ruta CH-199 (Freire, Villarrica, Pucón) y Ruta S-95-T (Villarrica, Licán Ray). */}
    <path
      d="M 40 56 L 64 200 L 268 200 M 64 200 L 52 318"
      fill="none"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="stroke-outline"
    ></path>

    {puntos.map((punto) => (
      <g>
        <circle
          cx={punto.x}
          cy={punto.y}
          r={punto.esBase ? 9 : 6}
          stroke-width="2"
          class:list={[
            'stroke-surface-container-lowest',
            punto.esBase ? 'fill-primary-container' : 'fill-on-surface',
          ]}
        />
        <text x={punto.rotuloX} y={punto.rotuloY} text-anchor={punto.ancla}>
          <tspan
            class:list={[
              'font-display text-label-lg uppercase',
              punto.esBase ? 'fill-primary' : 'fill-on-surface',
            ]}
          >
            {punto.nombre}
          </tspan>
          {punto.lineas.map((linea, indice) => (
            <tspan x={punto.rotuloX} dy="18" class="fill-secondary font-body text-body-md">
              {linea}
              {indice < punto.lineas.length - 1 ? ',' : ''}
            </tspan>
          ))}
        </text>
      </g>
    ))}
  </svg>
</div>
