---
import { Picture } from 'astro:assets';
import Contenedor from './Contenedor.astro';
import TituloSeccion from './TituloSeccion.astro';
import fotoBomberos from '../assets/fotos/10-rescate-nocturno-junto-a-bomberos.webp';
import fotoTraslado from '../assets/fotos/01-traslado-auto-accidentado-camino.webp';
import fotoCable from '../assets/fotos/07-rescate-con-cable-de-camioneta.webp';
import fotoDosGruas from '../assets/fotos/02-dos-gruas-en-carretera.webp';
import fotoNoche from '../assets/fotos/05-grua-de-noche-con-auto-chocado.webp';
import fotoJeep from '../assets/fotos/03-grua-con-jeep-sobre-plataforma.webp';
import fotoCaminoTierra from '../assets/fotos/08-rescate-de-auto-en-camino-de-tierra.webp';
import fotoPana from '../assets/fotos/04-grua-con-vehiculo-en-pana.webp';
import fotoAtardecer from '../assets/fotos/09-grua-al-atardecer-junto-al-volcan.webp';

/**
 * Galería de trabajos: bloque de la sección `#inicio` (RDA-009), entre Quiénes somos y las opiniones.
 * Sin interacción ni JavaScript. Las fotos se publican tal como están en las redes del negocio (RDA-011).
 *
 * @typedef {Object} Props
 * @property {string} [class] Clases adicionales de Tailwind.
 */

/** @type {Props} */
const { class: clase = '' } = Astro.props;

// Orden y textos alternativos aprobados en la iteración 04-02. La primera foto es apaisada y va destacada.
const destacada = {
  src: fotoBomberos,
  alt: 'Grúa trabajando junto a Bomberos en un rescate nocturno a las afueras de Villarrica.',
};

const fotos = [
  { src: fotoTraslado, alt: 'Grúa trasladando un auto accidentado por un camino de Villarrica.' },
  {
    src: fotoCable,
    alt: 'Grúa rescatando con cable una camioneta que se salió del camino entre Villarrica y Pucón.',
  },
  {
    src: fotoDosGruas,
    alt: 'Dos grúas trabajando juntas en la carretera, a las afueras de Villarrica.',
  },
  { src: fotoNoche, alt: 'Grúa de noche en Villarrica con un auto chocado sobre la plataforma.' },
  { src: fotoJeep, alt: 'Grúa llegando al centro de Villarrica con un jeep sobre la plataforma.' },
  {
    src: fotoCaminoTierra,
    alt: 'Grúa llegando a rescatar un auto pequeño a la orilla de un camino de tierra, a las afueras de Villarrica.',
  },
  { src: fotoPana, alt: 'Grúa en Pucón trasladando un vehículo que quedó en pana.' },
  {
    src: fotoAtardecer,
    alt: 'Grúa llegando al atardecer a un camino a los pies del volcán Villarrica.',
  },
];
---

<section
  aria-labelledby="titulo-trabajos"
  class:list={[
    'border-b border-surface-container-highest bg-surface-container-low py-space-xl text-on-surface',
    clase,
  ]}
>
  <Contenedor class="space-y-space-xl">
    <TituloSeccion id="titulo-trabajos">Trabajos en terreno</TituloSeccion>

    {/* Diez celdas: la destacada ocupa dos. Móvil, 2 columnas; desde `md`, 4; desde `lg`, 5 (dos filas).
        Cada imagen reserva su espacio con `width` y `height`, así que no hay saltos al cargar.
        `width` también fija la variante mayor: sin él, Astro publica además la foto a tamaño completo. */}
    <ul role="list" class="grid grid-cols-2 gap-space-sm md:grid-cols-4 lg:grid-cols-5">
      <li class="relative col-span-2 md:col-span-4 lg:col-span-2">
        <Picture
          src={destacada.src}
          alt={destacada.alt}
          formats={['avif']}
          fallbackFormat="webp"
          width={1440}
          height={804}
          widths={[480, 720, 960, 1440]}
          sizes="(min-width: 1280px) 492px, (min-width: 1024px) 40vw, calc(100vw - 40px)"
          class="block h-auto w-full lg:absolute lg:inset-0 lg:h-full lg:object-cover"
        />
      </li>
      {fotos.map((foto) => (
        <li>
          <Picture
            src={foto.src}
            alt={foto.alt}
            formats={['avif']}
            fallbackFormat="webp"
            width={640}
            height={640}
            widths={[160, 240, 320, 480, 640]}
            sizes="(min-width: 1280px) 242px, (min-width: 1024px) 19vw, (min-width: 768px) 23vw, 45vw"
            class="block h-auto w-full"
          />
        </li>
      ))}
    </ul>
  </Contenedor>
</section>
