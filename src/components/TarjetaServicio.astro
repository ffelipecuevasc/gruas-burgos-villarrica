---
import Icono from './Icono.astro';
import Boton from './Boton.astro';
import { enlaceWhatsApp } from '../data/negocio.js';

/**
 * @typedef {import('../data/servicios.js').Servicio} Servicio
 */

/**
 * Tarjeta de un servicio. Todas tienen la misma estructura: cuadro con el ícono, separador, título,
 * descripción, tres características y botón de WhatsApp.
 *
 * @typedef {Object} Props
 * @property {Servicio} servicio Objeto con la información del servicio.
 * @property {string} [class] Clases adicionales de Tailwind.
 */

/** @type {Props} */
const { servicio, class: clase = '' } = Astro.props;

// `astro check` no aplica el JSDoc de `Props` en el frontmatter, así que `servicio` llega sin tipo.
// `Array.from(…, String)` devuelve un `string[]` y el parámetro del `.map()` de abajo queda tipado.
const caracteristicas = Array.from(servicio.caracteristicas, String);
---

<article
  class:list={[
    'flex flex-col justify-between border border-surface-container-highest bg-surface-container-low text-on-surface p-space-lg transition-colors hover:border-primary-container',
    clase,
  ]}
>
  <div class="space-y-space-md">
    <div>
      <div class="inline-flex size-12 items-center justify-center bg-surface-container-highest text-primary">
        <Icono nombre={servicio.icono} class="size-6" />
      </div>
      <div class="mt-space-sm h-[2px] w-8 bg-primary" />
    </div>

    <div class="space-y-space-xs">
      <h3 class="font-display text-headline-sm text-on-surface uppercase">{servicio.titulo}</h3>
      <p class="font-body text-body-md text-secondary">{servicio.descripcion}</p>
    </div>

    <ul class="space-y-space-xs pt-space-xs font-body text-body-sm text-secondary">
      {caracteristicas.map((caracteristica) => (
        <li class="flex items-start gap-space-xs">
          <Icono nombre="verificacion" class="mt-0.5 size-4 shrink-0 text-primary" />
          <span>{caracteristica}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="mt-space-lg border-t border-surface-container pt-space-md">
    <Boton
      href={enlaceWhatsApp(servicio.mensajeWhatsApp)}
      variante="contorno"
      externo
      icono="whatsapp"
      class="w-full"
      aria-label={`Escribir por WhatsApp sobre ${servicio.titulo}`}
    >
      Escribir por WhatsApp
    </Boton>
  </div>
</article>
