---
import Contenedor from './Contenedor.astro';
import Icono from './Icono.astro';
import BotonLlamada from './BotonLlamada.astro';
import IndicadorDisponible from './IndicadorDisponible.astro';
import { negocio, enlaceTelefono } from '../data/negocio.js';

// Navegación por anclas de la página única (RDA-009). Con "/#…" también funciona desde la 404.
const enlaces = [
  { texto: 'Inicio', href: '/#inicio' },
  { texto: 'Servicios', href: '/#servicios' },
  { texto: 'Contacto', href: '/#contacto' },
];
---

<header class="sticky top-0 z-50 shadow-2xl">
  <div class="bg-surface-container-lowest border-surface-container-highest h-16 border-b">
    <Contenedor class="flex h-full items-center justify-between gap-space-md">
      {/* El enlace se estira con `::after` sobre todo el bloque de la marca: el isotipo y el indicador
          también llevan al inicio, y la marca se anuncia una sola vez (el isotipo es decorativo). */}
      <div class="relative flex items-center gap-space-sm">
        <span
          class="bg-primary-container text-on-accent flex size-10 shrink-0 items-center justify-center"
          aria-hidden="true"
        >
          <Icono nombre="marca" class="size-8" />
        </span>
        <div class="flex flex-col gap-space-xs">
          <a
            href="/"
            class="font-display text-headline-sm text-on-surface uppercase after:absolute after:inset-0 after:z-10"
          >
            {negocio.nombre}
          </a>
          <IndicadorDisponible />
        </div>
      </div>
      <div class="flex items-center gap-space-md">
        <a
          href={enlaceTelefono()}
          class="text-on-surface font-display text-headline-sm hover:text-primary hidden min-h-11 items-center gap-space-sm uppercase transition-colors duration-150 md:inline-flex"
        >
          <Icono nombre="llamada" class="text-primary-container size-6" />
          {negocio.telefono.visible}
        </a>
        <div class="hidden md:block">
          <BotonLlamada />
        </div>
        <a
          href={enlaceTelefono()}
          aria-label="Llamar a Grúas Burgos"
          class="bg-primary-container text-on-accent hover:bg-primary inline-flex size-12 items-center justify-center transition-colors duration-150 active:scale-95 md:hidden"
        >
          <Icono nombre="llamada" class="size-6" />
        </a>
      </div>
    </Contenedor>
  </div>
  <nav
    aria-label="Principal"
    class="bg-surface-container-low border-surface-container h-12 border-b"
  >
    <Contenedor class="flex h-full items-center">
      {/* El primer enlace no lleva relleno a la izquierda: así su texto sigue alineado con el margen
          y el anillo de foco cabe entero en la pantalla. */}
      <ul class="flex h-full items-center">
        {enlaces.map((enlace, indice) => (
          <li class="h-full">
            <a
              href={enlace.href}
              class:list={[
                'text-on-surface-variant hover:text-on-surface font-display text-label-md flex h-full items-center uppercase transition-colors duration-150',
                indice === 0 ? 'pr-space-md' : 'px-space-md',
              ]}
            >
              {enlace.texto}
            </a>
          </li>
        ))}
      </ul>
    </Contenedor>
  </nav>
</header>
