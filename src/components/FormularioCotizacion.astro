---
import Boton from './Boton.astro';
import BotonWhatsApp from './BotonWhatsApp.astro';
import { negocio, enlaceWhatsApp } from '../data/negocio.js';

/**
 * Formulario que arma un mensaje de WhatsApp (RDA-006). Valida el navegador; el script muestra
 * junto a cada campo el mensaje de error del propio navegador, quita los espacios sobrantes y
 * abre el chat.
 *
 * @typedef {Object} Props
 * @property {string} [class] Clases adicionales de Tailwind.
 */

/** @type {Props} */
const { class: clase = '' } = Astro.props;

const mensajeCotizacion = negocio.whatsapp.mensajes.cotizacion;

// Etiquetas visibles; el script las reutiliza en el mensaje mediante `data-etiqueta`.
const etiquetas = {
  nombre: 'Tu nombre',
  telefono: 'Tu teléfono',
  vehiculo: 'Tipo de vehículo',
  estado: '¿Qué le pasó?',
  origen: '¿Dónde está el vehículo?',
  destino: '¿Adónde lo llevamos?',
};

const claseEtiqueta = 'block font-display text-label-md text-on-surface uppercase';
const claseCampo =
  'min-h-12 w-full rounded-sm border border-outline bg-surface-container-lowest px-space-md font-body text-body-lg text-on-surface';
const claseError = 'font-body text-body-sm text-error';
---

<div
  class:list={[
    'space-y-space-md border border-surface-container-highest bg-surface-container-low p-space-lg text-on-surface md:p-space-xl',
    clase,
  ]}
>
  <h3 id="titulo-cotizacion" class="font-display text-headline-sm text-on-surface uppercase">
    Pide una cotización
  </h3>

  <noscript>
    <p class="mb-space-md font-body text-body-md text-secondary">
      Si el formulario no funciona, escríbenos directo por WhatsApp.
    </p>
    <BotonWhatsApp
      id="enlace-cotizacion"
      aria-labelledby="enlace-cotizacion titulo-cotizacion"
      variante="principal"
      mensaje={mensajeCotizacion}
    />
  </noscript>

  {/* Oculto con `hidden` hasta que el script lo muestra: sin JavaScript queda solo el enlace de arriba. */}
  <form
    id="form-cotizacion"
    hidden
    class="space-y-space-md"
    data-saludo={mensajeCotizacion.trim()}
    data-enlace={enlaceWhatsApp('')}
  >
    <div class="grid grid-cols-1 gap-space-md sm:grid-cols-2">
      <div class="space-y-space-xs">
        <label for="campo-nombre" class={claseEtiqueta}>
          {etiquetas.nombre}
        </label>
        <input
          type="text"
          id="campo-nombre"
          name="nombre"
          required
          autocomplete="name"
          data-etiqueta={etiquetas.nombre}
          aria-describedby="error-nombre"
          class={claseCampo}
        />
        <p id="error-nombre" aria-live="polite" class={claseError}></p>
      </div>

      <div class="space-y-space-xs">
        <label for="campo-telefono" class={claseEtiqueta}>
          {etiquetas.telefono}
        </label>
        <input
          type="tel"
          id="campo-telefono"
          name="telefono"
          required
          autocomplete="tel"
          pattern="[0-9+ \-]{8,16}"
          data-etiqueta={etiquetas.telefono}
          aria-describedby="error-telefono"
          class={claseCampo}
        />
        <p id="error-telefono" aria-live="polite" class={claseError}></p>
      </div>

      <div class="space-y-space-xs">
        <label for="campo-vehiculo" class={claseEtiqueta}>
          {etiquetas.vehiculo}
        </label>
        <select
          id="campo-vehiculo"
          name="vehiculo"
          required
          data-etiqueta={etiquetas.vehiculo}
          aria-describedby="error-vehiculo"
          class={claseCampo}
        >
          <option value="" disabled selected>
            Selecciona una opción
          </option>
          <option>Auto</option>
          <option>SUV</option>
          <option>Camioneta</option>
          <option>Otro</option>
        </select>
        <p id="error-vehiculo" aria-live="polite" class={claseError}></p>
      </div>

      <div class="space-y-space-xs">
        <label for="campo-estado" class={claseEtiqueta}>
          {etiquetas.estado}
        </label>
        <select
          id="campo-estado"
          name="estado"
          required
          data-etiqueta={etiquetas.estado}
          aria-describedby="error-estado"
          class={claseCampo}
        >
          <option value="" disabled selected>
            Selecciona una opción
          </option>
          <option>No arranca</option>
          <option>Accidentado</option>
          <option>Atascado fuera del camino</option>
          <option>Otro</option>
        </select>
        <p id="error-estado" aria-live="polite" class={claseError}></p>
      </div>
    </div>

    <div class="space-y-space-xs">
      <label for="campo-origen" class={claseEtiqueta}>
        {etiquetas.origen}
      </label>
      <input
        type="text"
        id="campo-origen"
        name="origen"
        required
        data-etiqueta={etiquetas.origen}
        aria-describedby="error-origen"
        class={claseCampo}
      />
      <p id="error-origen" aria-live="polite" class={claseError}></p>
    </div>

    <div class="space-y-space-xs">
      <label for="campo-destino" class={claseEtiqueta}>
        {etiquetas.destino} <span class="text-secondary">(opcional)</span>
      </label>
      <input
        type="text"
        id="campo-destino"
        name="destino"
        data-etiqueta={etiquetas.destino}
        class={claseCampo}
      />
    </div>

    <Boton type="submit" icono="whatsapp" class="w-full">
      Enviar por WhatsApp
    </Boton>
  </form>
</div>

<script>
  const form = document.forms.namedItem('form-cotizacion');

  if (form) {
    form.hidden = false;

    // Al fallar la validación del navegador, su mensaje queda visible junto al campo.
    for (const campo of [...form.querySelectorAll('input'), ...form.querySelectorAll('select')]) {
      const error = document.getElementById(`error-${campo.name}`);
      if (!error) continue;
      campo.addEventListener('invalid', () => {
        error.textContent = campo.validationMessage;
        campo.setAttribute('aria-invalid', 'true');
      });
      campo.addEventListener('input', () => {
        error.textContent = '';
        campo.removeAttribute('aria-invalid');
      });
      // Sin espacios sobrantes, un campo obligatorio con solo espacios queda vacío y no pasa la validación.
      campo.addEventListener('change', () => {
        campo.value = campo.value.trim();
      });
    }

    // `submit` solo se dispara cuando el navegador da por válidos todos los campos.
    form.addEventListener('submit', (evento) => {
      evento.preventDefault();
      const lineas = [form.dataset.saludo];
      new FormData(form).forEach((valor, nombre) => {
        const texto = String(valor).trim();
        const etiqueta = form.querySelector(`[name="${nombre}"]`)?.getAttribute('data-etiqueta');
        if (texto) lineas.push(`${etiqueta}: ${texto}`);
      });
      window.open(
        form.dataset.enlace + encodeURIComponent(lineas.join('\n')),
        '_blank',
        'noopener,noreferrer',
      );
    });
  }
</script>
