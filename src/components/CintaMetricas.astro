---
import Contenedor from './Contenedor.astro';

/**
 * @typedef {Object} Props
 * @property {string} [class] Clases adicionales de Tailwind.
 */

/** @type {Props} */
const { class: clase = '' } = Astro.props;

const metricas = [
  { valor: '24/7', etiqueta: 'Atención continua' },
  { valor: 'Grúa cama', etiqueta: 'Plataforma hidráulica' },
  { valor: 'Winche', etiqueta: 'Rescate 4x4' },
  { valor: 'Villarrica', etiqueta: 'Base en Vicente Reyes 870' },
];
---

<section
  aria-label="Métricas destacadas del servicio"
  class:list={[
    'border-b border-surface-container-highest bg-surface-container-low py-space-lg text-on-surface',
    clase,
  ]}
>
  <Contenedor>
    <dl class="grid grid-cols-2 gap-space-md sm:gap-space-lg md:grid-cols-4">
      {metricas.map((item) => (
        <div class="border-l-2 border-primary-container pl-space-md">
          <dt class="font-display text-headline-sm uppercase text-on-surface">{item.valor}</dt>
          <dd class="font-body text-body-sm text-secondary">{item.etiqueta}</dd>
        </div>
      ))}
    </dl>
  </Contenedor>
</section>
