---
import BotonWhatsApp from './BotonWhatsApp.astro';
import Icono from './Icono.astro';
import { negocio, enlaceTelefono } from '../data/negocio.js';

/**
 * @typedef {Object} Props
 * @property {string} [class] Clases adicionales de Tailwind.
 */

/** @type {Props} */
const { class: clase = '' } = Astro.props;
---

<aside
  aria-labelledby="titulo-despacho"
  class:list={[
    'w-full max-w-sm space-y-space-md border border-primary bg-primary-container p-space-lg text-on-accent shadow-xl',
    clase,
  ]}
>
  <p
    id="titulo-despacho"
    class="flex items-center gap-space-xs font-display text-label-md text-on-accent/90 uppercase"
  >
    <Icono nombre="llamada" class="size-4" />
    Despacho directo
  </p>

  <div>
    <p class="font-body text-body-sm text-on-accent/90">
      Atendido por sus propios dueños, a cualquier hora.
    </p>
    {/* Sobre naranja, el foco va en `on-accent`: `primary` no alcanza 3:1 contra este fondo. */}
    <a
      href={enlaceTelefono()}
      class="inline-flex min-h-11 items-center font-display text-headline-md text-on-accent uppercase hover:underline focus-visible:outline-on-accent"
    >
      {negocio.telefono.visible}
    </a>
  </div>

  <div class="border-t border-on-accent/20 pt-space-md">
    <BotonWhatsApp
      variante="secundario"
      class="w-full justify-center focus-visible:outline-on-accent"
    />
  </div>
</aside>
