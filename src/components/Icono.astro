---
import { Icon } from 'astro-icon/components';
import Isotipo from '../assets/marca/isotipo-gruas-burgos.svg';

// Única fuente de nombres de ícono del sitio (DESIGN.md §6).
// `marca` no está en este mapa: es el isotipo local, que no viene de un paquete de íconos.
const MARCA = 'marca';
const ICONOS = new Map(
  Object.entries({
    llamada: 'material-symbols:call-outline',
    whatsapp: 'simple-icons:whatsapp',
    instagram: 'simple-icons:instagram',
    facebook: 'simple-icons:facebook',
    tiktok: 'simple-icons:tiktok',
    horario: 'material-symbols:schedule-outline',
    emergencia: 'material-symbols:emergency-outline',
    rescate: 'material-symbols:home-repair-service-outline',
    traslado: 'material-symbols:rv-hookup-outline',
    'larga-distancia': 'material-symbols:distance-outline',
    verificacion: 'material-symbols:check-circle-outline',
    ubicacion: 'material-symbols:location-on-outline',
    cobertura: 'material-symbols:near-me-outline',
    advertencia: 'material-symbols:warning-outline',
    bateria: 'material-symbols:battery-charging-full-outline',
    neumatico: 'material-symbols:tire-repair-outline',
    pluma: 'material-symbols:precision-manufacturing-outline',
    maquinaria: 'material-symbols:front-loader-outline',
    efectivo: 'material-symbols:payments-outline',
    transferencia: 'material-symbols:account-balance-outline',
    debito: 'material-symbols:payment-card-outline',
    credito: 'material-symbols:credit-card-outline',
  }),
);

/**
 * @typedef {Object} Props
 * @property {string} nombre Clave del ícono, por ejemplo `llamada`, `whatsapp` o `marca` (el isotipo).
 * @property {string} [class] Clases de Tailwind para tamaño y color. Por defecto `size-6`.
 */

/** @type {Props} */
const { nombre, class: clase = 'size-6' } = Astro.props;

const esMarca = nombre === MARCA;
const id = ICONOS.get(nombre);
if (!esMarca && !id) {
  throw new Error(`Icono.astro: no existe el ícono "${nombre}". Revisa el mapa ICONOS.`);
}
---

{esMarca ? (
  <Isotipo class={clase} aria-hidden="true" />
) : (
  <Icon name={id} class={clase} aria-hidden="true" />
)}
