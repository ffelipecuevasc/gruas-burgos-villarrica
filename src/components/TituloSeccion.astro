---
/**
 * @typedef {Object} Props
 * @property {string} id `id` del `h2`; la sección lo usa en `aria-labelledby`.
 * @property {string} [etiqueta] Texto breve sobre el título. Úsalo solo si aporta información.
 * @property {string} [bajada] Párrafo de apoyo bajo el título.
 *
 * El slot `junto` admite un elemento a la derecha del título (por ejemplo, un logotipo). Queda fuera
 * del `h2`, así que no cambia su nombre accesible; si no cabe en la línea, pasa debajo.
 */

/** @type {Props} */
const { id, etiqueta, bajada } = Astro.props;
---

<header>
  {etiqueta && <p class="font-display text-label-md text-primary uppercase">{etiqueta}</p>}
  {Astro.slots.has('junto') ? (
    <div class="flex flex-wrap items-center gap-x-space-lg gap-y-space-sm">
      <h2 id={id} class="font-display text-headline-lg-mobile md:text-headline-lg uppercase">
        <slot />
      </h2>
      <slot name="junto" />
    </div>
  ) : (
    <h2 id={id} class="font-display text-headline-lg-mobile md:text-headline-lg uppercase">
      <slot />
    </h2>
  )}
  <div class="bg-on-surface mt-space-md h-[3px] w-10"></div>
  {bajada && <p class="text-secondary font-body text-body-lg mt-space-md max-w-2xl">{bajada}</p>}
</header>
