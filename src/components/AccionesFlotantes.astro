---
import Boton from './Boton.astro';
import BotonLlamada from './BotonLlamada.astro';
import BotonWhatsApp from './BotonWhatsApp.astro';
import { enlaceTelefono, enlaceWhatsApp } from '../data/negocio.js';
---

<div class="bg-surface-container-lowest fixed inset-x-0 bottom-0 z-40 flex pb-[env(safe-area-inset-bottom)] shadow-[0_-1px_0_0_var(--color-surface-container-highest)] md:hidden">
  <Boton href={enlaceTelefono()} icono="llamada" aria-label="Llamar ahora" class="h-14 flex-1">
    Llamar
  </Boton>
  <Boton
    href={enlaceWhatsApp()}
    variante="secundario"
    icono="whatsapp"
    externo
    aria-label="Escribir por WhatsApp"
    class="h-14 flex-1"
  >
    WhatsApp
  </Boton>
</div>

<div class="fixed right-space-lg bottom-space-lg z-40 hidden flex-col gap-space-sm md:flex">
  <BotonLlamada class="shadow-2xl" />
  <BotonWhatsApp variante="secundario" class="shadow-2xl" />
</div>
