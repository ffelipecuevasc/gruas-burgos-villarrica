---
import Boton from './Boton.astro';
import BotonLlamada from './BotonLlamada.astro';
import BotonWhatsApp from './BotonWhatsApp.astro';
import { enlaceTelefono, enlaceWhatsApp } from '../data/negocio.js';
---

{/* El borde superior suma 1 px a los 56 px de los botones: `LayoutBase` reserva 57 px en el `body`.
    Los botones llegan a los bordes de la pantalla, así que su anillo de foco se dibuja hacia adentro
    (el de afuera quedaría cortado). Sobre naranja va en `on-accent`: `primary` no alcanza 3:1. */}
<div class="bg-surface-container-lowest border-surface-container-highest fixed inset-x-0 bottom-0 z-40 flex border-t pb-[env(safe-area-inset-bottom)] md:hidden">
  <Boton
    href={enlaceTelefono()}
    icono="llamada"
    aria-label="Llamar ahora"
    class="h-14 flex-1 focus-visible:-outline-offset-3 focus-visible:outline-on-accent"
  >
    Llamar
  </Boton>
  <Boton
    href={enlaceWhatsApp()}
    variante="secundario"
    icono="whatsapp"
    externo
    aria-label="Escribir por WhatsApp"
    class="h-14 flex-1 focus-visible:-outline-offset-3"
  >
    WhatsApp
  </Boton>
</div>

{/* Desde `md`, el script marca este bloque con `data-oculto` mientras el pie está a la vista, para que
    los botones no tapen sus textos ni enlaces. Oculto no recibe foco ni lo anuncia un lector de
    pantalla (`display: none`); si uno de sus botones tiene el foco del teclado, sigue visible. Sin
    transición (DESIGN.md §8). Sin JavaScript no se ocultan: `Footer` les reserva espacio al final. */}
<div
  id="acciones-flotantes"
  class="fixed right-space-lg bottom-space-lg z-40 hidden flex-col gap-space-sm md:flex data-oculto:not-has-focus-visible:hidden"
>
  <BotonLlamada class="shadow-2xl" />
  <BotonWhatsApp variante="secundario" class="shadow-2xl" />
</div>

<script>
  const flotantes = document.getElementById('acciones-flotantes');
  const pie = document.getElementById('pie');

  if (flotantes && pie) {
    new IntersectionObserver((entradas) => {
      flotantes.toggleAttribute('data-oculto', entradas.at(-1)?.isIntersecting);
    }).observe(pie);
  }
</script>
