---
import Contenedor from './Contenedor.astro';
import BotonLlamada from './BotonLlamada.astro';
import BotonWhatsApp from './BotonWhatsApp.astro';
import TarjetaDespacho from './TarjetaDespacho.astro';

/**
 * @typedef {Object} Props
 * @property {string} [class] Clases adicionales de Tailwind.
 */

/** @type {Props} */
const { class: clase = '' } = Astro.props;
---

<section
  id="inicio"
  class:list={[
    'relative overflow-hidden bg-surface-container-lowest py-space-xl md:py-space-2xl border-b border-surface-container-highest',
    clase,
  ]}
>
  <!-- Textura CSS de fondo y degradado provisional hasta recibir foto real -->
  <div
    class="absolute inset-0 opacity-15 pointer-events-none bg-[radial-gradient(#ff5715_1px,transparent_1px)] [background-size:16px_16px]"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-0 bg-gradient-to-b from-surface/40 via-surface-container-lowest/80 to-surface-container-lowest pointer-events-none"
    aria-hidden="true"
  ></div>

  <Contenedor class="relative z-10">
    <div class="grid grid-cols-1 items-center gap-space-xl lg:grid-cols-12">
      <!-- Columna Izquierda: Urgencia y CTA Dual (Above-the-fold) -->
      <div class="space-y-space-md lg:col-span-7">
        <div class="inline-flex items-center gap-space-xs rounded-full border border-primary/30 bg-surface-container-low px-space-md py-space-xs font-display text-label-md uppercase text-primary">
          <span class="size-2 rounded-full bg-primary-container motion-safe:animate-pulse"></span>
          Asistencia en ruta 24/7
        </div>

        <h1 class="font-display text-headline-xl-mobile md:text-headline-xl uppercase text-on-surface tracking-tight">
          Grúas en Villarrica y La Araucanía, 24 horas
        </h1>

        <p class="font-body text-body-lg text-secondary max-w-xl">
          Traslado en grúa cama, rescate 4x4 y retiro de vehículos siniestrados en Villarrica,
          Pucón, Licán Ray, Freire y donde nos necesites.
        </p>

        <div class="flex flex-wrap gap-space-md pt-space-xs">
          <BotonLlamada variante="principal" />
          <BotonWhatsApp variante="contorno" mensaje="Hola, necesito una grúa en " />
        </div>
      </div>

      <!-- Columna Derecha: Tarjeta de Despacho (exclusiva escritorio/tablet) -->
      <div class="hidden md:flex md:justify-end lg:col-span-5">
        <TarjetaDespacho />
      </div>
    </div>
  </Contenedor>
</section>
