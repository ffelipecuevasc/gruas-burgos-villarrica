---
import { Picture } from 'astro:assets';
import Contenedor from './Contenedor.astro';
import BotonLlamada from './BotonLlamada.astro';
import BotonWhatsApp from './BotonWhatsApp.astro';
import TarjetaDespacho from './TarjetaDespacho.astro';
import { negocio } from '../data/negocio.js';
import fotoHero from '../assets/fotos/06-grua-de-noche-con-auto-accidentado.webp';

/**
 * Primer bloque de la sección `#inicio`. No es una sección propia: su `h1` da nombre a `#inicio`.
 *
 * @typedef {Object} Props
 * @property {string} idTitulo `id` del `h1`; la sección `#inicio` lo usa en `aria-labelledby`.
 * @property {string} [class] Clases adicionales de Tailwind.
 */

/** @type {Props} */
const { idTitulo, class: clase = '' } = Astro.props;

const localidades = negocio.cobertura.localidades.map((localidad) => localidad.nombre).join(', ');
---

<div
  class:list={[
    'relative overflow-hidden border-b border-surface-container-highest bg-surface-container-lowest py-space-xl',
    clase,
  ]}
>
  {/* Foto fija al 35 % bajo el velo (DESIGN.md §7). Es la imagen prioritaria de la página.
      En móvil el bloque es más alto que ancho: la foto ocupa solo el 60 % superior, para que la
      grúa se vea entera y no un recorte ampliado, y el velo llega a opaco justo donde termina.
      Desde `md` cubre todo el bloque. */}
  <Picture
    src={fotoHero}
    alt="Grúa con un auto accidentado sobre la plataforma, de noche, en un camino a las afueras de Villarrica."
    formats={['avif']}
    fallbackFormat="webp"
    widths={[640, 960, 1280, 1920]}
    sizes="(min-width: 768px) 100vw, 640px"
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-x-0 top-0 h-3/5 w-full object-cover opacity-35 md:h-full md:object-[center_65%]"
  />
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-surface-container-lowest/30 from-30% via-surface-container-lowest via-60% to-surface-container-lowest md:from-0% md:via-surface-container-lowest/55 md:via-50%"
    aria-hidden="true"
  ></div>

  <Contenedor class="relative z-10">
    <div class="grid grid-cols-1 items-center gap-space-xl lg:grid-cols-12">
      {/* Separaciones y `text-body-md` en móvil ajustados para que, a 360 × 640 px, los dos botones
          queden sobre la barra inferior con el `h1` en cuatro líneas (medido en la bitácora 03-05). */}
      <div class="space-y-space-md lg:col-span-7">
        <div class="space-y-space-xs">
          <p class="font-display text-label-md text-primary uppercase">Asistencia en ruta 24/7</p>

          <h1
            id={idTitulo}
            class="font-display text-headline-xl-mobile text-on-surface uppercase md:text-headline-xl"
          >
            Grúas en Villarrica y La Araucanía, 24 horas
          </h1>
        </div>

        <p class="max-w-xl font-body text-body-md text-secondary md:text-body-lg">
          Traslado en grúa cama, rescate 4x4 y retiro de vehículos siniestrados en {localidades} y
          donde nos necesites.
        </p>

        <div class="flex flex-wrap gap-x-space-md gap-y-space-sm">
          <BotonLlamada />
          <BotonWhatsApp />
        </div>
      </div>

      {/* Desde md: en móvil duplicaría las acciones del header, del hero y de la barra inferior. */}
      <div class="hidden md:flex md:justify-end lg:col-span-5">
        <TarjetaDespacho />
      </div>
    </div>
  </Contenedor>
</div>
