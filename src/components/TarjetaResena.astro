---
/**
 * @typedef {import('../data/resenas.js').Resena} Resena
 */

/**
 * @typedef {Object} Props
 * @property {Resena} resena Objeto con los datos de la reseña.
 * @property {string} [class] Clases adicionales de Tailwind.
 */

/** @type {Props} */
const { resena, class: clase = '' } = Astro.props;
const estrellas = '★'.repeat(resena.calificacion);
---

<article
  class:list={[
    'flex flex-col justify-between border border-surface-container-highest bg-surface-container-low p-space-lg text-on-surface',
    clase,
  ]}
>
  <div class="space-y-space-sm">
    <p class="text-label-lg text-primary-container" aria-hidden="true">
      {estrellas}
    </p>
    <p class="sr-only">Calificación: {resena.calificacion} de 5</p>

    <blockquote class="font-body text-body-md whitespace-pre-line text-secondary">
      {resena.comentario}
    </blockquote>
  </div>

  <footer class="mt-space-md flex items-center justify-between gap-space-sm border-t border-surface-container pt-space-sm">
    <div>
      <cite class="block font-display text-label-md text-on-surface uppercase not-italic">
        {resena.autor}
      </cite>
      <p class="font-body text-body-sm text-secondary">{resena.fechaRelativa}</p>
    </div>

    <a
      href={resena.urlResena}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Ver en Google la opinión de ${resena.autor}`}
      class="inline-flex min-h-11 shrink-0 items-center gap-space-xs font-display text-label-sm text-primary uppercase hover:underline"
    >
      Ver en Google
      <span aria-hidden="true">↗</span>
    </a>
  </footer>
</article>
