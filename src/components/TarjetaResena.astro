---
/**
 * @typedef {import('../data/resenas.js').Resena} Resena
 */

/**
 * @typedef {Object} Props
 * @property {Resena} resena Objeto con los datos de la reseña.
 * @property {string} [class] Clases adicionales de Tailwind.
 */

/** @type {Props} */
const { resena, class: clase = '' } = Astro.props;
const estrellas = Array.from({ length: resena.calificacion }, () => '★').join('');
---

<article
  class:list={[
    'flex flex-col justify-between rounded-sm border border-surface-container-highest bg-surface-container-low p-space-lg text-on-surface shadow-sm',
    clase,
  ]}
>
  <div class="space-y-space-sm">
    <!-- Calificación visual de estrellas y accesible para lector de pantalla -->
    <div class="flex items-center gap-space-xs text-primary-container" aria-hidden="true">
      <span class="tracking-widest text-label-lg">{estrellas}</span>
    </div>
    <span class="sr-only">Calificación: {resena.calificacion} de 5</span>

    <!-- Comentario íntegro con soporte de saltos de línea (white-space: pre-line) -->
    <blockquote class="font-body text-body-md text-secondary whitespace-pre-line">
      «{resena.comentario}»
    </blockquote>
  </div>

  <!-- Pie de tarjeta: Autor, Fecha y Enlace a la opinión en Google -->
  <footer class="mt-space-md border-t border-surface-container pt-space-sm flex items-center justify-between gap-space-sm font-body text-body-xs text-secondary">
    <div>
      <cite class="not-italic font-display text-label-md uppercase text-on-surface block">
        {resena.autor}
      </cite>
      <time class="text-secondary block">{resena.fechaRelativa}</time>
    </div>

    <a
      href={resena.urlResena}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Ver en Google la opinión de ${resena.autor}`}
      class="inline-flex items-center gap-1 font-display text-label-sm uppercase text-primary hover:underline focus-visible:outline-2 focus-visible:outline-primary transition-colors"
    >
      <span>Ver en Google</span>
      <span aria-hidden="true" class="text-xs">
        ↗
      </span>
    </a>
  </footer>
</article>
