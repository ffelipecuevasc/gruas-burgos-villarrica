---
import { negocio } from '../data/negocio.js';
import vistaPrevia from '../assets/marca/vista-previa-gruas-burgos.jpg';

/**
 * Metadatos de búsqueda, íconos y vista previa (Open Graph y Twitter Card) de cada página.
 * El JSON-LD del negocio va aparte, en `DatosEstructurados.astro`, y solo en la portada.
 *
 * @typedef {Object} Props
 * @property {string} titulo Contenido de `<title>` y de `og:title`.
 * @property {string} descripcion Meta descripción y `og:description`, sin cifras ni afirmaciones no confirmadas.
 * @property {boolean} [noindex] Excluye la página de los buscadores y omite el canonical y `og:url`.
 */

/** @type {Props} */
const { titulo, descripcion, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// `surface-container-lowest` de DESIGN.md §2.1: una etiqueta `meta` no puede leer la variable CSS.
const colorTema = '#0e0e0e';

// La imagen se compone en la página de desarrollo /muestrario/vista-previa (1200 × 630 px).
const imagen = new URL(vistaPrevia.src, Astro.site).href;
const textoImagen = `${negocio.nombre}, grúas en Villarrica 24/7`;
---

<title>{titulo}</title>
<meta name="description" content={descripcion} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta name="theme-color" content={colorTema} />

{/* `sizes` evita que Chrome prefiera el .ico al SVG; el .ico queda para navegadores sin soporte de SVG. */}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<meta property="og:type" content="website" />
<meta property="og:locale" content="es_CL" />
<meta property="og:site_name" content={negocio.nombre} />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descripcion} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={imagen} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content={String(vistaPrevia.width)} />
<meta property="og:image:height" content={String(vistaPrevia.height)} />
<meta property="og:image:alt" content={textoImagen} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={descripcion} />
<meta name="twitter:image" content={imagen} />
<meta name="twitter:image:alt" content={textoImagen} />
