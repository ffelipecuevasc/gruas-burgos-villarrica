---
import Contenedor from './Contenedor.astro';
import Icono from './Icono.astro';
import { negocio, enlaceTelefono, localidadesTexto, PENDIENTE_CLIENTE } from '../data/negocio.js';

// Año del pie: se calcula al compilar, porque el sitio es estático.
const anio = new Date().getFullYear();

const redes = [
  { nombre: 'Instagram', icono: 'instagram', href: negocio.redes.instagram },
  { nombre: 'Facebook', icono: 'facebook', href: negocio.redes.facebook },
  { nombre: 'TikTok', icono: 'tiktok', href: negocio.redes.tiktok },
];

// Los datos que el cliente aún no confirma (PENDIENTE_CLIENTE) nunca se muestran.
const hayCobertura = negocio.cobertura.localidades.length > 0;
const hayFacturacion =
  negocio.facturacion.razonSocial !== PENDIENTE_CLIENTE &&
  negocio.facturacion.rut !== PENDIENTE_CLIENTE;
---

<footer class="bg-surface-container-lowest border-surface-container-low border-t">
  <Contenedor class="grid grid-cols-1 gap-space-xl py-space-xl md:grid-cols-3">
    <div class="space-y-space-sm">
      <p class="font-display text-headline-sm uppercase">{negocio.nombre}</p>
      <div class="bg-on-surface h-[3px] w-10"></div>
      <p class="text-secondary font-body text-body-sm">{negocio.eslogan}</p>
      <p class="text-secondary font-body text-body-sm flex items-center gap-space-xs">
        <Icono nombre="ubicacion" class="text-primary size-5" />
        {negocio.direccion.texto}
      </p>
    </div>
    {hayCobertura && (
      <div class="space-y-space-sm">
        <h2 class="font-display text-headline-sm uppercase">Cobertura</h2>
        <div class="bg-on-surface h-[3px] w-10" />
        <p class="text-secondary font-body text-body-sm">{localidadesTexto()}</p>
      </div>
    )}
    <div class="space-y-space-sm">
      <h2 class="font-display text-headline-sm uppercase">Contacto directo</h2>
      <div class="bg-on-surface h-[3px] w-10"></div>
      <p>
        <a
          href={enlaceTelefono()}
          class="text-primary font-display text-headline-sm inline-flex min-h-11 items-center hover:underline"
        >
          {negocio.telefono.visible}
        </a>
      </p>
      <p>
        <a
          href={`mailto:${negocio.correo}`}
          class="text-secondary hover:text-primary font-body text-body-sm inline-flex min-h-11 items-center underline"
        >
          {negocio.correo}
        </a>
      </p>
      <ul class="flex gap-space-sm">
        {redes.map((red) => (
          <li>
            <a
              href={red.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${red.nombre} de ${negocio.nombre}`}
              class="bg-surface-container-highest text-on-surface hover:text-primary flex size-11 items-center justify-center transition-colors duration-150"
            >
              <Icono nombre={red.icono} class="size-6" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Contenedor>
  {/* Desde `md` reserva al final el alto de los botones flotantes más su holgura (el mismo valor que
      `scroll-padding-bottom` en `global.css`): al llegar al final de la página no tapan el pie. */}
  <div class="bg-surface-container-low md:pb-37">
    <Contenedor class="text-secondary font-body text-body-sm flex flex-col gap-space-sm py-space-md md:flex-row md:items-center md:justify-between">
      <p>
        © {anio} {negocio.nombre}
      </p>
      {hayFacturacion && (
        <p>
          {negocio.facturacion.razonSocial} · RUT {negocio.facturacion.rut}
        </p>
      )}
      <p>
        Sitio desarrollado por{' '}
        <a
          href="https://felipecuevas.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary inline-flex min-h-11 items-center underline"
        >
          Felipe Cuevas
        </a>
      </p>
    </Contenedor>
  </div>
</footer>
