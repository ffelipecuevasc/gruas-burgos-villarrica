---
import Contenedor from './Contenedor.astro';
import BotonLlamada from './BotonLlamada.astro';

/**
 * Cierre de la sección `#contacto` (RDA-009).
 *
 * @typedef {Object} Props
 * @property {string} [class] Clases adicionales de Tailwind.
 */

/** @type {Props} */
const { class: clase = '' } = Astro.props;
---

<section
  aria-labelledby="titulo-cinta-llamada"
  class:list={['bg-primary-container py-space-xl text-on-accent', clase]}
>
  <Contenedor class="flex flex-col items-center justify-between gap-space-lg text-center sm:flex-row sm:text-left">
    <h3
      id="titulo-cinta-llamada"
      class="font-display text-headline-lg-mobile text-on-accent uppercase md:text-headline-lg"
    >
      ¿Quedaste en pana?
    </h3>

    {/* Sobre naranja, el foco va en `on-accent`: `primary` no alcanza 3:1 contra este fondo. */}
    <BotonLlamada variante="secundario" class="shrink-0 focus-visible:outline-on-accent" />
  </Contenedor>
</section>
