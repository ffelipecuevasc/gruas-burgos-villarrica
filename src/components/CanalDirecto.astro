---
import BotonLlamada from './BotonLlamada.astro';
import BotonWhatsApp from './BotonWhatsApp.astro';
import Icono from './Icono.astro';
import { negocio, enlaceTelefono, enlaceComoLlegar } from '../data/negocio.js';

/**
 * @typedef {Object} Props
 * @property {string} [class] Clases adicionales de Tailwind.
 */

/** @type {Props} */
const { class: clase = '' } = Astro.props;
---

<div class:list={['space-y-space-lg', clase]}>
  <div class="space-y-space-md border border-surface-container-highest bg-surface-container-low p-space-lg md:p-space-xl">
    <a
      href={enlaceTelefono()}
      class="inline-flex min-h-11 items-center font-display text-headline-lg-mobile text-on-surface uppercase transition-colors hover:text-primary md:text-headline-lg"
    >
      {negocio.telefono.visible}
    </a>

    <div class="flex flex-wrap gap-space-md">
      <BotonLlamada />
      <BotonWhatsApp mensaje={negocio.whatsapp.mensajes.ubicacion}>
        Enviar mi ubicación por WhatsApp
      </BotonWhatsApp>
    </div>

    <p class="font-body text-body-sm text-secondary">
      En WhatsApp, toca el clip o el signo + y elige «Ubicación».
    </p>
  </div>

  <div class="grid grid-cols-1 gap-space-md md:grid-cols-2">
    <div class="space-y-space-xs border border-surface-container-highest bg-surface-container-low p-space-lg">
      <div class="flex items-center gap-space-xs font-display text-label-md text-primary uppercase">
        <Icono nombre="ubicacion" class="size-5" />
        <h3 class="text-on-surface">Base de operaciones</h3>
      </div>
      <p class="font-body text-body-md text-secondary">{negocio.direccion.texto}</p>
      <a
        href={enlaceComoLlegar()}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center gap-space-xs font-display text-label-sm text-primary uppercase hover:underline"
      >
        Cómo llegar
        <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="space-y-space-xs border border-surface-container-highest bg-surface-container-low p-space-lg">
      <div class="flex items-center gap-space-xs font-display text-label-md text-primary uppercase">
        <Icono nombre="horario" class="size-5" />
        <h3 class="text-on-surface">Horario</h3>
      </div>
      <p class="font-body text-body-md text-secondary">Atención 24 horas, los 7 días.</p>
    </div>

    {/* Bloque destacado: borde y barra de acento, y cada medio con su ícono en un cuadro, como las
        tarjetas de servicio. Dos columnas (una bajo 360 px, donde los nombres no caben de a dos) y cuatro
        de `md` a `lg`, donde el bloque ocupa todo el ancho. */}
    <div class="space-y-space-md border border-l-4 border-primary-container bg-surface-container p-space-lg md:col-span-2">
      <h3 class="font-display text-label-lg text-on-surface uppercase">Medios de pago</h3>
      <ul
        role="list"
        class="grid grid-cols-1 gap-space-md min-[360px]:grid-cols-2 md:grid-cols-4 lg:grid-cols-2"
      >
        {negocio.pagos.medios.map((medio) => (
          <li class="flex items-center gap-space-sm">
            <span class="inline-flex size-10 shrink-0 items-center justify-center bg-surface-container-highest text-primary">
              <Icono nombre={medio.icono} class="size-6" />
            </span>
            <span class="font-display text-label-md text-on-surface uppercase">{medio.nombre}</span>
          </li>
        ))}
      </ul>
      <p class="font-body text-body-md text-secondary">{negocio.pagos.documentos}</p>
    </div>
  </div>
</div>
