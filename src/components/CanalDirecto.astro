---
import BotonLlamada from './BotonLlamada.astro';
import BotonWhatsApp from './BotonWhatsApp.astro';
import Icono from './Icono.astro';
import { negocio, enlaceTelefono, enlaceComoLlegar } from '../data/negocio.js';

/**
 * @typedef {Object} Props
 * @property {string} [class] Clases adicionales de Tailwind.
 */

/** @type {Props} */
const { class: clase = '' } = Astro.props;
---

<div class:list={['space-y-space-lg', clase]}>
  <!-- Bloque de Canal Directo -->
  <div class="rounded-sm border border-surface-container-highest bg-surface-container-low p-space-lg md:p-space-xl">
    <div class="space-y-space-md">
      <div>
        <p class="font-display text-label-md uppercase text-primary tracking-wider">
          Atención Inmediata
        </p>
        <a
          href={enlaceTelefono()}
          class="mt-space-xs block font-display text-headline-lg-mobile md:text-headline-lg uppercase tracking-tight text-on-surface hover:text-primary transition-colors focus-visible:outline-2 focus-visible:outline-primary"
        >
          {negocio.telefono.visible}
        </a>
      </div>

      <div class="flex flex-wrap gap-space-md pt-space-xs">
        <BotonLlamada variante="principal" />
        <BotonWhatsApp
          variante="contorno"
          mensaje="Hola, necesito una grúa. Te envío mi ubicación por aquí. "
        >
          Enviar mi ubicación por WhatsApp
        </BotonWhatsApp>
      </div>

      <p class="font-body text-body-sm text-secondary">
        En WhatsApp, toca el clip o el signo + y elige «Ubicación».
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-space-md md:grid-cols-2">
    <!-- Tarjeta Dirección -->
    <div class="rounded-sm border border-surface-container-highest bg-surface-container-low p-space-lg space-y-space-xs">
      <div class="flex items-center gap-space-xs text-primary font-display text-label-md uppercase">
        <Icono nombre="ubicacion" class="size-5" />
        <h3 class="text-on-surface">Base de operaciones</h3>
      </div>
      <p class="font-body text-body-md text-secondary">{negocio.direccion.texto}</p>
      <div class="pt-space-xs">
        <a
          href={enlaceComoLlegar()}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 font-display text-label-sm uppercase text-primary hover:underline focus-visible:outline-2 focus-visible:outline-primary"
        >
          <span>Cómo llegar</span>
          <span aria-hidden="true" class="text-xs">
            ↗
          </span>
        </a>
      </div>
    </div>

    <!-- Tarjeta Horario -->
    <div class="rounded-sm border border-surface-container-highest bg-surface-container-low p-space-lg space-y-space-xs">
      <div class="flex items-center gap-space-xs text-primary font-display text-label-md uppercase">
        <Icono nombre="llamada" class="size-5" />
        <h3 class="text-on-surface">Horario</h3>
      </div>
      <p class="font-body text-body-md text-secondary">Atención 24 horas, los 7 días.</p>
    </div>
  </div>
</div>
