---
import '../../styles/global.css';
import { Font } from 'astro:assets';
import Icono from '../../components/Icono.astro';
import { negocio } from '../../data/negocio.js';
import foto from '../../assets/fotos/06-grua-de-noche-con-auto-accidentado.webp';

// Página de desarrollo (04-01): fuente de `src/assets/marca/vista-previa-gruas-burgos.jpg`, la
// imagen de `og:image`. Solo existe con `pnpm dev`, en /muestrario/vista-previa. Si cambia el
// teléfono o el nombre, se captura de nuevo el bloque de 1200 × 630 px y se reemplaza el archivo.
export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { muestrario: 'muestrario' } }] : [];
}
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1200" />
    <meta name="robots" content="noindex" />
    <title>Imagen de vista previa | {negocio.nombre}</title>
    <Font cssVariable="--font-barlow-condensed" />
  </head>
  <body>
    <div id="vista-previa" class="vp">
      <img src={foto.src} alt="" class="vp-foto" />
      <div class="vp-velo"></div>
      <div class="vp-franja"></div>
      <div class="vp-texto">
        <p class="vp-marca">
          <Icono nombre="marca" class="vp-isotipo" />
          {negocio.nombre}
        </p>
        <p class="vp-titular">Grúas en Villarrica 24/7</p>
        <div class="vp-barra"></div>
        <p class="vp-telefono">{negocio.telefono.visible}</p>
      </div>
    </div>
  </body>
</html>

{/* Estilos propios y no utilidades de Tailwind: así esta página no agrega reglas al CSS publicado. */}
<style is:global>
  body {
    margin: 0;
  }

  .vp {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    background: var(--color-surface-container-lowest);
    font-family: var(--font-barlow-condensed), 'Arial Narrow', sans-serif;
    text-transform: uppercase;
  }

  .vp-foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Oscurece la foto con `surface-container-lowest` (#0e0e0e): más denso bajo el texto. */
  .vp-velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgb(14 14 14 / 0.9) 0%,
      rgb(14 14 14 / 0.74) 55%,
      rgb(14 14 14 / 0.35) 100%
    );
  }

  .vp-franja {
    position: absolute;
    inset: 0 auto 0 0;
    width: 12px;
    background: var(--color-primary-container);
  }

  .vp-texto {
    position: relative;
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    padding: 0 64px 0 80px;
  }

  .vp-texto p {
    line-height: 1;
  }

  .vp-marca {
    display: flex;
    align-items: center;
    gap: 20px;
    color: var(--color-on-surface);
    font-size: 64px;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .vp-isotipo {
    width: 96px;
    height: 96px;
    color: var(--color-primary-container);
  }

  .vp-titular {
    margin-top: 28px;
    color: var(--color-on-surface);
    font-size: 96px;
    font-weight: 800;
    letter-spacing: 0.03em;
  }

  .vp-barra {
    width: 96px;
    height: 6px;
    margin-top: 32px;
    background: var(--color-on-surface);
  }

  .vp-telefono {
    margin-top: 32px;
    color: var(--color-primary-container);
    font-size: 112px;
    font-weight: 800;
    letter-spacing: 0.03em;
  }
</style>
