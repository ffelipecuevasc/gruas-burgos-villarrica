---
import LayoutBase from '../layouts/LayoutBase.astro';
import Contenedor from '../components/Contenedor.astro';
import Boton from '../components/Boton.astro';
import BotonLlamada from '../components/BotonLlamada.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import { negocio } from '../data/negocio.js';

const titulo = `Página no encontrada | ${negocio.nombre}`;
const descripcion =
  'La página que buscas no existe. Si necesitas una grúa en Villarrica y La Araucanía, llámanos o escríbenos por WhatsApp.';
---

<LayoutBase titulo={titulo} descripcion={descripcion} noindex>
  <section
    aria-labelledby="titulo-404"
    class="flex min-h-[60vh] items-center bg-surface py-space-xl"
  >
    <Contenedor class="w-full text-center">
      <p class="font-display text-headline-sm text-primary uppercase">Error 404</p>
      <h1
        id="titulo-404"
        class="mt-space-xs font-display text-headline-xl-mobile text-on-surface uppercase md:text-headline-xl"
      >
        Página no encontrada
      </h1>

      {/* `text-body-md` en móvil, como el párrafo del hero: a 360 × 640 px los tres botones quedan
          completos sobre la barra inferior. */}
      <p class="mx-auto mt-space-md max-w-lg font-body text-body-md text-secondary md:text-body-lg">
        La dirección a la que intentas acceder no está disponible. Si necesitas una grúa, llámanos o
        escríbenos por WhatsApp.
      </p>

      <div class="mt-space-xl flex flex-wrap items-center justify-center gap-space-md">
        <BotonLlamada />
        <BotonWhatsApp />
        {/* El relleno del botón secundario no se distingue del fondo `surface`: el borde `outline`
            lo delimita con 5,87:1 (WCAG 1.4.11). */}
        <Boton href="/" variante="secundario" class="border border-outline">
          Volver al inicio
        </Boton>
      </div>
    </Contenedor>
  </section>
</LayoutBase>
