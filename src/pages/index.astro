---
import LayoutBase from '../layouts/LayoutBase.astro';
import Contenedor from '../components/Contenedor.astro';
import Hero from '../components/Hero.astro';
import CintaMetricas from '../components/CintaMetricas.astro';
import QuienesSomos from '../components/QuienesSomos.astro';
import GaleriaTrabajos from '../components/GaleriaTrabajos.astro';
import Resenas from '../components/Resenas.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import TarjetaServicio from '../components/TarjetaServicio.astro';
import BloqueEquipamiento from '../components/BloqueEquipamiento.astro';
import CanalDirecto from '../components/CanalDirecto.astro';
import ListaCobertura from '../components/ListaCobertura.astro';
import MapaCobertura from '../components/MapaCobertura.astro';
import AvisoSeguridad from '../components/AvisoSeguridad.astro';
import FormularioCotizacion from '../components/FormularioCotizacion.astro';
import CintaLlamada from '../components/CintaLlamada.astro';
import DatosEstructurados from '../components/DatosEstructurados.astro';
import { servicios } from '../data/servicios.js';
import { negocio } from '../data/negocio.js';

// Ocho tarjetas iguales en una sola grilla, sin huecos: de a dos desde `md`; de `lg` a `xl`, tres,
// tres y dos (6 columnas: las dos últimas ocupan la mitad cada una); desde `xl`, cuatro y cuatro.
const anchoNormal = 'lg:col-span-2 xl:col-span-1';
const anchoUltimas = 'lg:col-span-3 xl:col-span-1';

const titulo = `${negocio.nombre} | Grúas en Villarrica 24 horas`;
const descripcion =
  'Grúas, traslado y rescate vehicular en Villarrica, disponibles las 24 horas. Llama o escríbenos por WhatsApp.';
---

<LayoutBase titulo={titulo} descripcion={descripcion}>
  <DatosEstructurados slot="head" />

  {/* Seis secciones ancladas (RDA-009): `#inicio`, `#servicios`, `#quienes-somos`, `#trabajos`,
      `#opiniones` y `#contacto`. */}
  <section id="inicio" aria-labelledby="titulo-inicio">
    <Hero idTitulo="titulo-inicio" />
    <CintaMetricas />
  </section>

  <section
    id="servicios"
    aria-labelledby="titulo-servicios"
    class="border-b border-surface-container-highest bg-surface py-space-xl text-on-surface"
  >
    <Contenedor class="space-y-space-xl">
      <TituloSeccion
        id="titulo-servicios"
        bajada="Atendemos autos, SUV y camionetas en la ciudad, en caminos rurales y en rutas de cordillera."
      >
        Servicios
      </TituloSeccion>

      <div class="grid grid-cols-1 gap-space-lg md:grid-cols-2 lg:grid-cols-6 xl:grid-cols-4">
        {servicios.map((servicio, indice) => (
          <TarjetaServicio
            servicio={servicio}
            class={indice >= servicios.length - 2 ? anchoUltimas : anchoNormal}
          />
        ))}
      </div>

      <BloqueEquipamiento />
    </Contenedor>
  </section>

  <QuienesSomos />
  <GaleriaTrabajos />
  <Resenas />

  {/* El relleno vertical va en el contenedor para que la cinta final llegue al borde de la sección. */}
  <section id="contacto" aria-labelledby="titulo-contacto" class="bg-surface text-on-surface">
    <Contenedor class="space-y-space-xl py-space-xl">
      <TituloSeccion
        id="titulo-contacto"
        bajada="Llámanos o escríbenos: atendemos las 24 horas, los 7 días."
      >
        Contacto
      </TituloSeccion>

      <div class="grid grid-cols-1 items-start gap-space-xl lg:grid-cols-12">
        <div class="space-y-space-lg lg:col-span-5">
          <CanalDirecto />
          <AvisoSeguridad />
        </div>
        <div class="lg:col-span-7">
          <FormularioCotizacion />
        </div>
      </div>

      <div class="grid grid-cols-1 items-start gap-space-xl border-t border-surface-container-highest pt-space-xl lg:grid-cols-12">
        <div class="lg:col-span-5">
          <ListaCobertura />
        </div>
        <div class="lg:col-span-7">
          <MapaCobertura />
        </div>
      </div>
    </Contenedor>

    <CintaLlamada />
  </section>
</LayoutBase>
