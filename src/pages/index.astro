---
import LayoutBase from '../layouts/LayoutBase.astro';
import Hero from '../components/Hero.astro';
import CintaMetricas from '../components/CintaMetricas.astro';
import { negocio, enlaceTelefono } from '../data/negocio.js';

const titulo = `${negocio.nombre} | Grúas en Villarrica 24 horas`;
const descripcion =
  'Grúas, traslado y rescate vehicular en Villarrica, disponibles las 24 horas. Llama o escríbenos por WhatsApp.';
---

<LayoutBase titulo={titulo} descripcion={descripcion}>
  <!-- Estructura provisional (RDA-009). Contenido y estilos definitivos: épicas 02 y 03. -->
  <Hero />
  <CintaMetricas />
  <h2 class="mt-12 text-2xl font-bold">Quiénes somos</h2>

  <section id="servicios" aria-labelledby="titulo-servicios" class="px-4 py-12">
    <h2 id="titulo-servicios" class="text-2xl font-bold">
      Servicios
    </h2>
  </section>

  <section id="contacto" aria-labelledby="titulo-contacto" class="px-4 py-12">
    <h2 id="titulo-contacto" class="text-2xl font-bold">
      Contacto
    </h2>
    <ul class="mt-4 space-y-2">
      <li>
        Teléfono y WhatsApp:{' '}
        <a href={enlaceTelefono()} class="underline">
          {negocio.telefono.visible}
        </a>
      </li>
      <li>
        Correo:{' '}
        <a href={`mailto:${negocio.correo}`} class="underline">
          {negocio.correo}
        </a>
      </li>
      <li>Base: {negocio.direccion.texto}</li>
      <li>Horario: {negocio.horario.texto}</li>
    </ul>
  </section>
</LayoutBase>
